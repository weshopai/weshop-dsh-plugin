{
  "name": "weshop-dsh-plugin",
  "version": "0.1.0",
  "private": false,
  "description": "Native Cordis WeShop canvas, tools, skills, and Web UI for DeepSeek Harness",
  "license": "MIT",
  "bin": {
    "weshop-dsh-plugin": "bin/setup.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/weshopai/weshop-dsh-plugin.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "skills/**",
    "presets/**",
    "assets/**",
    "README.zh-CN.md",
    "cordis.patch.yml",
    "bin"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@phosphor-icons/react": "^2.1.10"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2"
  }
}
